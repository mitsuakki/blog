---
layout: none
permalink: /search.json
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": "{{ post.url | relative_url }}",
    "date": "{{ post.date | date: '%Y-%m-%d' }}",
    "tags": {{ post.tags | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | truncate: 500 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
{% for proj in site.projects %}
  ,{
    "title": {{ proj.title | prepend: 'project: ' | jsonify }},
    "url": "{{ proj.url | relative_url }}",
    "date": "{{ proj.updated | date: '%Y-%m-%d' }}",
    "tags": {{ proj.topics | jsonify }},
    "excerpt": {{ proj.description | jsonify }},
    "content": ""
  }
{% endfor %}
]
